# Copiar como .env y completar. Nunca subir el .env real al repositorio.

# Frontend (Vite)
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_API_URL=http://localhost:3001

# API (node app.js)
PORT=3001
# Minimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<secreto-aleatorio-de-64-caracteres-hex>
# Origenes que pueden llamar a la API, separados por coma (en Render: la URL del frontend)
CLIENT_ORIGIN=http://localhost:5173
# IDs de usuario que pueden usar /blockchain/tamper y /blockchain/reset (demo), separados por coma
BLOCKCHAIN_ADMIN_IDS=

# Entorno Blue Team (entorno-blue-team/docker-compose.yml)
# Modo del WAF: DetectionOnly (solo registra) u On (bloquea)
WAF_MODE=DetectionOnly
WAF_PARANOIA=1
# SIEM (perfil "siem"). Contrasenas largas y aleatorias; nunca reutilizar.
ELASTIC_VERSION=8.15.3
ELASTIC_PASSWORD=<contrasena-elastic>
KIBANA_PASSWORD=<contrasena-kibana_system>
# Minimo 32 caracteres
KIBANA_ENCRYPTION_KEY=<clave-aleatoria-de-32-o-mas-caracteres>
