[
  {
    "rule_id": "cifrados-01-waf-sqli",
    "name": "CIF-01 · Inyección SQL detectada por el WAF (CRS 942xxx)",
    "description": "El WAF (ModSecurity + OWASP CRS) marcó una petición con una regla de inyección SQL. Caso de abuso CA-01, RS-08 y RS-13.",
    "type": "query",
    "language": "kuery",
    "index": [
      "cifrados-logs-*"
    ],
    "query": "app_component : \"waf\" and modsec.transaction.messages.details.tags : \"attack-sqli\"",
    "severity": "high",
    "risk_score": 73,
    "interval": "1m",
    "from": "now-2m",
    "enabled": true,
    "max_signals": 100,
