                  "pm.environment.set('ts_poc01', t);",
                  "console.log('poc01', t, pm.response.code, pm.response.responseSize + ' bytes');",
                  "pm.test('200 y varios usuarios', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().users.length).to.be.above(1); });"
                ]
              }
            }
