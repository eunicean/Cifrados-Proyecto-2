{
  "info": {
    "_postman_id": "7c3f0472-95f6-450b-9075-bac815ceb73a",
    "name": "Cifrados-WAF · Hito 2 Red Team",
    "description": "Repetición de los PoC del Hito 2 contra http://localhost:8080 (WAF). Cada petición guarda su hora (America/Guatemala) en ts_<poc> y la imprime en la consola de Postman para que el Blue Team la busque en Kibana.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 · Bypass (puerto directo)",
      "item": [
        {
          "name": "API directa :3001 (debe fallar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = new Date().toLocaleString('sv-SE', { timeZone: 'America/Guatemala' });",
                  "pm.environment.set('ts_bypass', t);",
                  "console.log('bypass', t, pm.response.code, pm.response.responseSize + ' bytes');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_directo}}/groups",
              "host": [
                "{{base_url_directo}}"
              ],
              "path": [
                "groups"
              ]
            },
            "description": "Si responde, la API está expuesta sin pasar por el WAF (hallazgo). Esperado: error de conexión."
          }
        }
      ]
    },
    {
      "name": "1 · Sesión",
      "item": [
        {
          "name": "Login Carol (guarda el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = new Date().toLocaleString('sv-SE', { timeZone: 'America/Guatemala' });",
                  "pm.environment.set('ts_login', t);",
                  "console.log('login', t, pm.response.code, pm.response.responseSize + ' bytes');",
                  "if (pm.response.code === 200) { pm.environment.set('token', pm.response.json().token); }",
                  "pm.test('login 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión como Carol y guarda el JWT en la variable token.",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{carol_email}}\", \"password\": \"{{carol_password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
